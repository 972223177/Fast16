<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- API 31+ 覆盖：接入系统 SplashScreen。
         windowSplashScreenAnimatedIcon 用方形 layer-list（非 adaptive），
         避免默认 app icon（adaptive）被系统圆形 mask 裁切成圆。 -->
    <style name="Theme.Fast16" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/pixel_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowBackground">@color/pixel_bg</item>
        <item name="android:statusBarColor">@color/pixel_bg</item>
        <item name="android:navigationBarColor">@color/pixel_panel</item>
    </style>
</resources>
